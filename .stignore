# Streamlit ignore file to reduce file watching overhead
# Git directory
.git/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Large data directories (but still include them in the app)
# We want to serve these files but don't need to watch them for changes
data/evaluation_*/
data/*.parquet

# Development files
*.ipynb
.DS_Store

# Logs
*.log 